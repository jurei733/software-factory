FROM node:26.13.0-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94
COPY picocolors-1.1.0.tgz picocolors-1.1.1.tgz /tmp/packages/
RUN npm cache add --ignore-scripts --cache /opt/factory-deps/npm-cache /tmp/packages/*.tgz \
    && chmod -R a+rX /opt/factory-deps && rm -rf /tmp/packages
